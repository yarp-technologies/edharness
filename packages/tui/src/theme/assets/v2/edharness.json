        "300": "#4c97a4",
        "400": "#64a8b4",
        "500": "#7bb8c4",
        "600": "#92c9d4",
        "700": "#a8dbe4",
        "800": "#bfecf4",
        "900": "#e3fafe"
      },
      "blue": {
        "100": "#3730a3",
        "200": "#4f46e5",
        "300": "#6366f1",
        "400": "#818cf8",
        "500": "#a5b4fc",
        "600": "#c7d2fe",
        "700": "#d8dfff",
        "800": "#e5e9ff",
        "900": "#f2f3ff"
      },
      "purple": {
        "100": "#6b21a8",
        "200": "#7e22ce",
        "300": "#9333ea",
        "400": "#a855f7",
        "500": "#c084fc",
        "600": "#d8b4fe",
        "700": "#e9d5ff",
        "800": "#f3e8ff",
        "900": "#faf5ff"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "orange",
      "green",
      "blue",
      "red"
    ],
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      },
      "feedback": {
        "warning": {
          "base": "#8d6200"
        }
      }
    },
    "border": {
      "base": "#d6d6e0"
    },
    "scrollbar": {
      "base": "#8a8a98"
    },
    "diff": {
      "text": {
        "added": "#1e725c",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      },
      "background": {
        "added": "#d5e5d5",
        "removed": "#f7d8db"
      },
      "highlight": {
        "added": "#4db380",
        "removed": "#f52a65"
      },
      "lineNumber": {
        "text": "#595959",
        "background": {
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }
      }
    },
    "syntax": {
      "number": "$hue.accent.200",
      "type": "#b0851f"
    },
    "markdown": {
      "blockQuote": "#b0851f",
      "emphasis": "#b0851f",
      "strong": "$hue.accent.200"
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#f5f3f0",
        "300": "#dbd8d3",
        "400": "#b1ada8",
        "500": "#2c2825",
