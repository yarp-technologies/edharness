        "400": "#7852ad",
        "500": "#603e8e",
        "600": "#4a2e70",
        "700": "#351f52",
        "800": "#241338",
        "900": "#130821"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "text": {
      "action": {
        "primary": {
          "$focused": "#0e101f"
        }
      }
    }
  }
}
