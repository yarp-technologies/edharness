        "900": "#fef3e7"
      },
      "green": {
        "100": "#1f8c44",
        "200": "#278042",
        "300": "#55a96a",
        "400": "#6cb77c",
        "500": "#81c68f",
        "600": "#96d5a3",
        "700": "#ace4b6",
        "800": "#c1f3ca",
        "900": "#e1fee6"
      },
      "cyan": {
        "100": "#077786",
